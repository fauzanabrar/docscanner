NODE_ENV=production
PORT=3000
JWT_SECRET=your-random-secret-here
UPLOAD_DIR=/data/docscanner/uploads
DB_PATH=/data/docscanner/db.sqlite
MAX_UPLOAD_SIZE=524288000
AUDIO_JOB_TIMEOUT_MS=7200000
MAX_ACTIVE_AUDIO_JOBS=2
ANONYMOUS_DOC_EXPIRY=86400

# Path to the yt-dlp cookies file (Netscape format). Managed in-app via the
# "YouTube Cookies" dialog in the Video tools. Defaults to <UPLOAD_DIR>/video-jobs/cookies.txt
# when unset. In Docker it lives in the docscanner-data volume.
YOUTUBE_COOKIES=/data/docscanner/cookies.txt

# Transcription / translation tuning (optional)
# ORT_NUM_THREADS=2          # ONNX intra-op threads (default: all cores). Lower on small ARM CPUs.
# TRANSFORMERS_CACHE=/data/docscanner/cache  # Persistent model cache across container restarts.
